classDiagram
    class Owner {
        +str name
        +list~Pet~ pets
        +create_pet(name, species, breed, age) Pet
        +delete_pet(pet_name) void
        +edit_pet_info(pet, attribute, value) void
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +int age
        +str species
        +str breed
        +list~Task~ tasks
        +add_task(task) void
        +remove_task(task_name) void
        +get_tasks() list~Task~
    }

    class Task {
        +str task_name
        +str description
        +str priority
        +date date
        +time time
        +int duration_minutes
        +bool is_complete
        +change_priority(new_priority) void
        +change_date(new_date) void
    }

    class Scheduler {
        +Owner owner
        +generate_schedule(available_minutes) dict
        +get_tasks_for_date(date) dict
    }

    Owner "1" --> "0..*" Pet : owns
    Pet "1" --> "0..*" Task : has
    Scheduler "1" --> "1" Owner : organizes tasks for
